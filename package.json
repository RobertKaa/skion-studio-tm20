{
  "name": "skion-studio",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "test:desktop-ux": "tsx --tsconfig tsconfig.app.json scripts/test-desktop-ux.tsx",
    "test:environment": "tsx scripts/test-preview-environment.ts && tsx scripts/test-project-file.ts",
    "test:reset": "tsx scripts/test-reset-skin.ts && tsx scripts/test-reset-model.ts && tsx scripts/test-project-file.ts",
    "test:projects": "tsx scripts/test-project-file.ts && tsx scripts/test-large-project.ts && tsx scripts/test-resolution.ts",
    "test:performance": "tsx scripts/test-adaptive-preview.ts && tsx scripts/test-resolution.ts",
    "test:underbody": "tsx scripts/test-underbody-view.ts && tsx scripts/test-decal-projection.ts && tsx scripts/test-preview-environment.ts",
    "test:generator": "tsx scripts/test-generator.ts",
    "test:element-copy": "tsx scripts/test-element-copy.ts",
    "preview": "vite preview",
    "preview:gh": "vite build && vite preview --base /skion-studio-tm20/"
  },
  "dependencies": {
    "fabric": "^7.4.0",
    "jszip": "^3.10.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.185.0",
    "@vitejs/plugin-react": "^6.0.3",
    "oxlint": "^1.71.0",
    "tsx": "^4.23.0",
    "typescript": "~6.0.2",
    "vite": "^8.1.1"
  }
}
